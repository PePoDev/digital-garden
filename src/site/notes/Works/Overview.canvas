---
{"dg-publish":true,"dg-content-classes":"canvas-page","permalink":"/works/overview.canvas/","contentClasses":"canvas-page","dgPassFrontmatter":true,"dg-note-properties":{}}
---

<div id="Overviewcanvas" class="canvas-wrapper hide">
	<svg class="canvas-background">
		<defs>
			<pattern id="canvas-grid-Overviewcanvas" width="25" height="25" patternUnits="userSpaceOnUse">
				<circle r="1.5" cx="12.5" cy="12.5"></circle>
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill="url(#canvas-grid-Overviewcanvas)"></rect>
	</svg>
	<div class="canvas">
		<svg class="canvas-edges-container" style="position:absolute;width:1px;height:1px;overflow:visible;">
			<defs><marker id="arrow-vartextmuted" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
			<path d="M0,0.5 L5,3 L0,5.5" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		</marker>
		<marker id="arrow-vartextmuted-start" markerWidth="6" markerHeight="6" refX="1" refY="3" orient="auto-start-reverse" markerUnits="strokeWidth">
			<path d="M6,0.5 L1,3 L6,5.5" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		</marker><filter x="-0.1" y="-0.1" width="1.2" height="1.3" id="edge-label-bg">
			<feFlood flood-color="var(--background-primary)" flood-opacity="1" result="bg"/>
			<feMerge>
				<feMergeNode in="bg"/>
				<feMergeNode in="SourceGraphic"/>
			</feMerge>
		</filter></defs><path d="M -345 -680 C -273 -680, -237 -680, -165 -680" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="6c4a974842b2ffc7"  marker-end="url(#arrow-vartextmuted)" /><text x="-255" y="-680" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">publish</text>
<path d="M -437 -800 C -437 -750, -437.5 -760, -437.5 -710" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="77cedf7ee8e8613e"  marker-end="url(#arrow-vartextmuted)" /><text x="-437.25" y="-755" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">trigger</text>
<path d="M -411 -382 C -354.8085415743638 -382, -379.1914584256362 -272.5, -323 -272.5" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="d6a3ed7b80277cdb"  marker-end="url(#arrow-vartextmuted)" />
<path d="M -411 -382 C -361 -382, -373 -430, -323 -430" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="0b7a184a356028cf"  marker-end="url(#arrow-vartextmuted)" />
<path d="M -345 -150 C -292.68212542543415 -150, -231.5 -162.68212542543418, -231.5 -215" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="c065299728a20d99"  marker-end="url(#arrow-vartextmuted)" /><text x="-268.6307970345378" y="-162.8807970345378" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">lab</text>
<path d="M -158 -430 C -106.58015947127024 -430, -91.41984052872976 -481, -40 -481" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="9227a3742577866c"  marker-end="url(#arrow-vartextmuted)" />
		</svg>
		<div class="canvas-node canvas-node-text " data-node-id="66a9f60ab0691041" style="transform: translate(-530px, -710px); width: 185px; height: 60px; ">
	<div class="canvas-node-container">
